theme = Catppuccin Frappe

font-family = JetBrains Mono
font-size = 13

# Splits
keybind = alt+backslash=new_split:right
keybind = alt+minus=new_split:down
keybind = alt+x=close_surface

# Navigate splits
keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:bottom
keybind = alt+k=goto_split:top
keybind = alt+l=goto_split:right
keybind = ctrl+left=goto_split:left
keybind = ctrl+right=goto_split:right
keybind = ctrl+up=goto_split:top
keybind = ctrl+down=goto_split:bottom

# Resize splits
keybind = alt+shift+h=resize_split:left,40
keybind = alt+shift+j=resize_split:down,40
keybind = alt+shift+k=resize_split:up,40
keybind = alt+shift+l=resize_split:right,40

# Tabs
keybind = alt+t=new_tab
keybind = alt+w=close_tab
keybind = alt+right=next_tab
keybind = alt+left=previous_tab
keybind = alt+one=goto_tab:1
keybind = alt+two=goto_tab:2
keybind = alt+three=goto_tab:3
keybind = alt+four=goto_tab:4
keybind = alt+five=goto_tab:5

# Zoom split (toggle fullscreen for focused split)
keybind = alt+z=toggle_split_zoom

# Unfocused splits are dimmed
unfocused-split-opacity = 0.85

# Clipboard
copy-on-select = clipboard
